rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function u() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function ok() { return request.auth != null && u().role != 'pending'; }
    function role() { return u().role; }
    function staff() { return ok() && role() in ['admin','committee']; }
    function scoped(d) { return staff() || (role() == 'coordinator' && d.wing == u().wing) || (role() == 'resident' && d.flatId == u().flatId); }
    match /users/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || (ok() && role() == 'admin'));
      allow create: if request.auth.uid == id && request.resource.data.role == 'pending';
      allow update: if ok() && role() == 'admin';
    }
    match /flats/{id} {
      allow read: if ok() && scoped(resource.data);
      allow write: if ok() && role() == 'admin';
    }
    match /{c}/{id} {
      allow read: if ok() && c in ['payments','donations'] && scoped(resource.data);
      allow create: if ok() && c in ['payments','donations'] && (staff() || (role() == 'coordinator' && request.resource.data.wing == u().wing));
      allow delete: if ok() && c in ['payments','donations','expenses'] && role() == 'admin';
    }
    match /expenses/{id} {
      allow read: if ok();
      allow create, update: if staff();
    }
    match /log/{id} {
      allow read: if ok() && role() == 'admin';
      allow create: if ok();
    }
  }
}
